{
  "selector": "source.c++, source.cpp, source.c",
  "file_regex": "^\\s*(.*)\\(([0-9]+)\\)\\s*: ()(.*)$",
  "working_dir": "$folder",

  "shell_cmd": "\"$packages/buz-cpp-build/buz-cpp-build.bat\" edit $folder D:/build",
  
  // "target": "ansi_color_build",
  // "syntax": "Packages/ANSIescape/ANSI.sublime-syntax",

  "variants": [
    {
      "name": "Build",
      "shell_cmd": "\"$packages/buz-cpp-build/buz-cpp-build.bat\" build $folder D:/build",
    },
    {
      "name": "Build And Run",
      "shell_cmd": "\"$packages/buz-cpp-build/buz-cpp-build.bat\" buildAndRun $folder D:/build",
    },
    {
      "name": "Build And Run In Visual Studio",
      "shell_cmd": "\"$packages/buz-cpp-build/buz-cpp-build.bat\" buildAndRunVS $folder D:/build",
    },

    {
      "name": "Edit Build Settings",
      "shell_cmd": "\"$packages/buz-cpp-build/buz-cpp-build.bat\" edit $folder D:/build",
    },
    {
      "name": "Run CMake",
      "shell_cmd": "\"$packages/buz-cpp-build/buz-cpp-build.bat\" runcmake $folder D:/build"
    },
    {
      "name": "List Targets",
      "shell_cmd": "\"$packages/buz-cpp-build/buz-cpp-build.bat\" listTargets $folder D:/build"
    },
    {
      "name": "Open CMakeCache.txt",
      "shell_cmd": "\"$packages/buz-cpp-build/buz-cpp-build.bat\" cmakecache $folder D:/build"
    },
    {
      "name": "Open Build Folder",
      "shell_cmd": "\"$packages/buz-cpp-build/buz-cpp-build.bat\" buildfolder $folder D:/build"
    }
  ]
}
